# Postgres (Neon, Supabase, Railway...). Sem esta variável, o `npm run dev` usa um banco local em .pglite/
DATABASE_URL=postgres://usuario:senha@host:5432/empreita

# Endereço público do app (sem barra no fim). Usado nos links do orçamento e no PDF que o WhatsApp baixa.
APP_URL=https://empreita.exemplo.com.br

# WhatsApp Cloud API (Meta)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=invente-um-texto-secreto
WHATSAPP_APP_SECRET=
WHATSAPP_GRAPH_VERSION=v23.0

# Teste fechado: só estes números podem usar o bot (DDI+DDD+número, separados por vírgula). Vazio = todos.
TESTADORES=

# Simulador em /simulador. Ligado fora de produção; em produção só com SIMULADOR_ATIVO=1 (não recomendado).
SIMULADOR_ATIVO=
